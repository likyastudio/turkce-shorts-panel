# --- Veritabanı (PostgreSQL - Cloud SQL / Supabase / Neon) ---
# Boş bırakılırsa yerelde otomatik SQLite (/tmp/likya_crosspost.db) kullanılır
DATABASE_URL=postgresql://user:password@host:5432/likya_crosspost

# --- Google Cloud Storage (Instagram geçici MP4 barındırma, 24s lifecycle) ---
GCS_BUCKET_NAME=likya-temp-videos
USE_GCS_SIGNED_URL=true

# --- Güvenlik & CORS ---
API_SECRET_KEY=degistir-guclu-bir-anahtar-yaz
# Panele Google ile girebilecek hesaplar (virgülle). Gerçek adresleri depoya yazmayın.
ALLOWED_LOGIN_EMAILS=ornek@example.com
ALLOWED_ORIGINS=https://likyastudios.live,https://likyastudio.github.io,http://localhost:3000,http://localhost:8787
PUBLIC_API_BASE=https://likya-crosspost-api-xxxx-ew.a.run.app
FRONTEND_URL=https://likyastudio.github.io/turkce-shorts-panel/

# --- YouTube Data API v3 (Google Cloud OAuth 2.0 Web Client) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# --- Instagram Graph API v21.0 (Meta Developer App) ---
META_APP_ID=
META_APP_SECRET=
